PORT=4000
JWT_SECRET=change-this-to-a-long-random-string

# Drivers within this many km of the pickup can accept directly and get notified
NEARBY_KM=10
# Minutes before an unaccepted request is re-broadcast (notify radius grows each retry)
RETRY_MINUTES=10
MAX_RETRIES=5
# Set to true to require admin approval of new drivers
REQUIRE_APPROVAL=false
ADMIN_KEY=change-this-admin-key

# OSRM-compatible routing service used for directions and ETA.
# The public demo server is fine for testing only — self-host OSRM for production.
ROUTING_URL=https://router.project-osrm.org

# Where the SQLite database and driver document uploads are stored. Point this
# at a mounted persistent volume/disk in production (see README > Deploying).
DB_PATH=./data/trackmovers.db
UPLOADS_DIR=./data/uploads

# --- M-Pesa Daraja (STK Push) --------------------------------------------
# Get these from https://developer.safaricom.co.ke after creating an app.
# Leave MPESA_CONSUMER_KEY blank to disable payments (the Pay button is hidden).
MPESA_ENV=sandbox
# paybill (Lipa na M-Pesa Paybill) or till (Buy Goods)
MPESA_SHORTCODE_TYPE=paybill
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Must be a public HTTPS URL Safaricom can reach — e.g. https://yourapp.com/api/payments/callback/<MPESA_CALLBACK_SECRET>
MPESA_CALLBACK_URL=
MPESA_CALLBACK_SECRET=change-this-too

# --- Email for "forgot password" reset codes -------------------------------
# Leave SMTP_HOST blank in development: codes are printed to the server
# console instead of being emailed, so the flow still works without SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MyTruckMovers <no-reply@example.com>
